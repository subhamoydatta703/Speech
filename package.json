{
  "name": "speech",
  "private": true,
  "workspaces": ["backend", "frontend", "desktop", "packages/*"],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "bun run --cwd backend build",
    "build:frontend": "bun run --cwd frontend build",
    "typecheck": "bun run --cwd backend typecheck",
    "test": "bun test backend/test",
    "dev:backend": "bun run --cwd backend dev",
    "dev:frontend": "bun run --cwd frontend dev",
    "dev:desktop": "bun run --cwd desktop dev",
    "build:desktop": "bun run --cwd desktop build",
    "package:windows": "bun run --cwd desktop package:windows"
  },
  "dependencies": {
    "@prisma/client": "7.10.1"
  }
}
