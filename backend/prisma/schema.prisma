generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "postgresql"
}

// Only the fields requested in the final authentication example.
// No audio, transcripts, passwords, device sessions, or usage history.
model User {
  id    String @id @db.VarChar(191)
  email String @db.VarChar(254)
}
