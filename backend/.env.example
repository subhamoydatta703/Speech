NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Neon dashboard: pooled URL for runtime, direct URL for Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-YOUR-PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-YOUR-PROJECT.REGION.aws.neon.tech/neondb?sslmode=require

# Clerk Dashboard > API keys > JWT public key (PEM). Literal \n is supported.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_CLERK_PUBLIC_KEY\n-----END PUBLIC KEY-----"
CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

HF_TOKEN=REPLACE_WITH_SERVER_ONLY_HUGGING_FACE_TOKEN
# Verify this model is available through hf-inference for your account before launch.
HF_MODEL=openai/whisper-large-v3
MAX_AUDIO_SECONDS=60
MAX_UPLOAD_BYTES=5242880
MAX_CONCURRENT_REQUESTS=4
REQUESTS_PER_MINUTE=60
PROVIDER_TIMEOUT_MS=45000
REQUEST_TIMEOUT_MS=90000
