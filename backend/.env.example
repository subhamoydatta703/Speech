NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Neon PostgreSQL URL used by both PrismaPg and Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-YOUR-PROJECT-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Clerk Dashboard > API keys
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
CORS_ORIGINS=http://localhost:3000

MAX_CONCURRENT_REQUESTS=4
REQUESTS_PER_MINUTE=60
REQUEST_TIMEOUT_MS=10000

# On Render: HOST=0.0.0.0; use the platform-provided PORT.
# Model downloads and transcription run on the desktop, not this API.

# Optional private signed Windows installer; leave empty until a real release exists.
# Relative paths resolve from the backend working directory. Never expose this file publicly.
WINDOWS_INSTALLER_PATH=
